# Assembled static site for the browser build (web/build-site.sh)
web/dist/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Maven build output
target/

# IDE metadata (auto-generated by Eclipse / Java Language Server)
.classpath
.project
.settings/

# User data files
config/setting/*
!config/setting/.gitkeep
log/
/replay/

# Bazel convenience symlinks (contents live under ~/.cache/bazel)
/bazel-*
# Per-user Bazel overrides (MODULE.bazel.lock and maven_install.json are tracked)
.bazelrc.user

# Agent directories
.claude
.codex
.serena

# Coverage reports (bazel coverage --combined_report=lcov + genhtml)
/coverage/
# JaCoCo offline-instrumentation execution data (emitted when the bazel-built
# instrumented classes are run directly, e.g. local single-test verification)
/jacoco.exec
.tokensave/
