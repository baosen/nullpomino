load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_test")

java_library(
    name = "testutil",
    srcs = glob(["mu/nu/nullpo/testutil/*.java"]),
    javacopts = ["-encoding", "UTF-8"],
    visibility = ["//visibility:private"],
    deps = ["//src/main/java:nullpomino"],
)

java_test(
    name = "AllTests",
    srcs = glob(
        ["**/*.java"],
        exclude = ["mu/nu/nullpo/testutil/*.java"],
    ),
    args = [
        "execute",
        "--select-package=mu.nu.nullpo",
        "--disable-banner",
        "--fail-if-no-tests",
    ],
    data = [
        "//:config_files",
        "//src/test/resources:test_resources",
    ],
    javacopts = ["-encoding", "UTF-8"],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    use_testrunner = False,
    deps = [
        ":testutil",
        "//src/main/java:nullpomino",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_console",
    ],
)

java_binary(
    name = "BaselineRecorder",
    main_class = "mu.nu.nullpo.testutil.BaselineRecorder",
    runtime_deps = [":testutil"],
)
