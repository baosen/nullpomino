load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_test")
load(":test_map.bzl", "EXTRA_SRCS", "SELECT_CLASSES", "TEST_DEPS")

java_library(
    name = "testutil",
    srcs = glob(["nullpomino/testutil/*.java"]),
    javacopts = ["-encoding", "UTF-8"],
    visibility = ["//visibility:private"],
    deps = ["//src/main/java:nullpomino"],
)

# Fallback for files TEST_DEPS can't resolve (shouldn't normally be hit --
# TEST_DEPS is generated from every nullpomino.* import/reference a test
# makes, see gen_test_map.py).
DEFAULT_DEPS = [
    "//src/main/java:core",
    "//src/main/java:sdl_binding",
]

# package dir -> main-code deps, for the handful of dirs that need a target
# TEST_DEPS doesn't know about (sdl_binding_jna, the Swing tool targets).
# Takes priority over TEST_DEPS since it also carries those extra targets.
PKG_DEPS = {
    "nullpomino/gui/sdl/binding": ["//src/main/java:sdl_binding"],
    "nullpomino/gui/sdl/binding/jna": [
        "//src/main/java:sdl_binding",
        "//src/main/java:sdl_binding_jna",
        "@maven//:net_java_dev_jna_jna",
    ],
    "nullpomino/tool": ["//src/main/java:swing_tool_util"],
    "nullpomino/tool/musiclisteditor": DEFAULT_DEPS + ["//src/main/java:tool_musiclisteditor"],
    "nullpomino/tool/ruleeditor": DEFAULT_DEPS + [
        "//src/main/java:swing_tool_util",
        "//src/main/java:tool_ruleeditor",
    ],
    "nullpomino/tool/sequencer": DEFAULT_DEPS + [
        "//src/main/java:swing_tool_util",
        "//src/main/java:tool_sequencer",
    ],
}

FILE_DEPS = {
    "nullpomino/game/mode/ModeReplayCharacterisationTest.java": [":testutil"],
}

# One java_test per test file: parallel, individually runnable, and cached at
# file granularity. Cross-file references between test sources are compiled in
# via EXTRA_SRCS (see gen_test_map.py); only the file's own classes are
# selected, so no test runs twice.
[java_test(
    name = f[len("nullpomino/"):-len(".java")].replace("/", "_"),
    size = "small",
    srcs = [f] + EXTRA_SRCS.get(f, []),
    args = ["execute"] + [
        "--select-class=" + c
        for c in SELECT_CLASSES.get(f, [f[:-len(".java")].replace("/", ".")])
    ] + [
        "--include-classname=.*",
        "--disable-banner",
        "--fail-if-no-tests",
    ],
    data = [
        "//:test_config_files",
        "//src/test/resources:test_resources",
    ],
    javacopts = ["-encoding", "UTF-8"],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    resource_strip_prefix = "src/test/resources",
    resources = ["//src/test/resources:logback-test.xml"],
    use_testrunner = False,
    deps = (PKG_DEPS.get(f.rsplit("/", 1)[0]) or TEST_DEPS.get(f, DEFAULT_DEPS)) + FILE_DEPS.get(f, []) + [
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_console",
    ],
) for f in glob(
    ["**/*.java"],
    exclude = [
        "nullpomino/testutil/*.java",
        # Documentation-only class with zero tests (records a dead-code
        # analysis); --fail-if-no-tests would reject a target for it.
        "nullpomino/game/mode/RetroMarathonModeBranchCoverageTest4.java",
    ],
)]

java_binary(
    name = "BaselineRecorder",
    main_class = "nullpomino.testutil.BaselineRecorder",
    runtime_deps = [":testutil"],
)

java_binary(
    name = "CorpusGenerator",
    main_class = "nullpomino.testutil.CorpusGenerator",
    runtime_deps = [":testutil"],
)
