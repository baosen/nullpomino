    name = "swing_tool_util",
    srcs = ["nullpomino/tool/SwingToolUtil.java"],
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# The engine + GUI cluster, split into fine-grained targets along its actual
# dependency structure so an edit to one leaf (a randomizer, a wallkick, a
# net protocol class, ...) only invalidates the targets that really depend on
# it instead of the whole cluster. Two clusters below (core_engine,
# core_ui_modes) are genuinely cyclic at the file level (util <-> game <->
# gui/net <-> gui/sdl) and can't be split further without source changes;
# everything else here is a real DAG over them, verified by import-graph
# analysis (see plan in git history / PR description), not guesswork.
# ---------------------------------------------------------------------------

# Layer 0: leaf data holders and pure utilities with no deps on the rest of
# the cluster.

java_library(
    name = "game_component_data",
    srcs = glob(
        ["nullpomino/game/component/*.java"],
        exclude = [
            "nullpomino/game/component/Block.java",
            "nullpomino/game/component/Field.java",
            "nullpomino/game/component/FieldAnalysis.java",
            "nullpomino/game/component/FieldCascade.java",
            "nullpomino/game/component/FieldColorClear.java",
            "nullpomino/game/component/FieldGarbage.java",
            "nullpomino/game/component/FieldSerializer.java",
            "nullpomino/game/component/Piece.java",
            "nullpomino/game/component/RuleOptions.java",
        ],
    ),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [":util_base"],
)

java_library(
    name = "util_base",
    srcs = [
        "nullpomino/util/ClassFactory.java",
