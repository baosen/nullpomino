load("@rules_java//java:defs.bzl", "java_library")

JAVACOPTS = ["-encoding", "UTF-8"]

SLF4J = "@maven//:org_slf4j_slf4j_api"

LOGBACK = "@maven//:ch_qos_logback_logback_classic"

LOGBACK_CORE = "@maven//:ch_qos_logback_logback_core"

JNA = "@maven//:net_java_dev_jna_jna"

# Backend-neutral SDL binding interfaces. Deliberately JNA-free so the
# core can also run on the browser (TeaVM) backend.
java_library(
    name = "sdl_binding",
    srcs = glob(["nullpomino/gui/sdl/binding/*.java"]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
)

# Desktop backend: JNA bindings to the native SDL3 libraries. Selected at
# runtime by reflection (SdlBackend), so binaries must carry it in
# runtime_deps explicitly.
java_library(
    name = "sdl_binding_jna",
    srcs = glob(["nullpomino/gui/sdl/binding/jna/*.java"]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":sdl_binding",
        JNA,
    ],
)

TEAVM_JSO = [
    "@maven//:org_teavm_teavm_interop",
    "@maven//:org_teavm_teavm_jso",
    "@maven//:org_teavm_teavm_jso_apis",
    "@maven//:org_teavm_teavm_platform",
]

# Web backend: TeaVM JSO (Canvas2D/WebAudio/localStorage) implementation of the
# SDL binding. Compiled to JS by //web:classes_js; also javac-compiles on the
# JVM (JSO annotations are plain annotations there) so `bazel build //...`
# stays green.
java_library(
    name = "sdl_binding_teavm",
    srcs = glob(["nullpomino/gui/sdl/binding/teavm/*.java"]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [":sdl_binding"] + TEAVM_JSO,
)

# Spike-only slice of the game logic (component/wallkick/randomizer/AI-base/
# engine + manager, plus the util classes they need), deliberately excluding
# logback so a TeaVM compile failure here can't be confused with a
# logback/Joran failure. See tools/teavm/spike/BUILD.bazel.
java_library(
    name = "game_logic_spike",
    srcs = [
        "nullpomino/game/ai/AIPlayer.java",
        "nullpomino/game/ai/DummyAI.java",
        "nullpomino/game/event/EventReceiver.java",
        "nullpomino/game/mode/GameMode.java",
        "nullpomino/game/play/GameEngine.java",
        "nullpomino/game/play/GameManager.java",
        "nullpomino/util/ClassFactory.java",
        "nullpomino/util/CustomProperties.java",
        "nullpomino/util/DataDir.java",
        "nullpomino/util/GeneralUtil.java",
        "nullpomino/util/JdkRandom.java",
        "nullpomino/util/LegacyClassNames.java",
    ] + glob([
        "nullpomino/game/component/*.java",
        "nullpomino/game/randomizer/*.java",
        "nullpomino/game/wallkick/*.java",
    ]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [SLF4J],
)

java_library(
    name = "swing_tool_util",
    srcs = ["nullpomino/tool/SwingToolUtil.java"],
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
)

# Cyclically-coupled engine + GUI cluster:
# util <-> game <-> gui/net <-> gui/sdl, plus tool/airankstool which
# is depended on by game/ai (RanksAI). Cannot be split further without source
# refactors to break the cycles.
java_library(
    name = "core",
    srcs = glob([
        "nullpomino/util/*.java",
        "nullpomino/game/**/*.java",
        "nullpomino/gui/*.java",
        "nullpomino/gui/net/*.java",
        "nullpomino/gui/sdl/*.java",
        "nullpomino/gui/sdl/widget/*.java",
        "nullpomino/tool/airankstool/*.java",
    ]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":sdl_binding",
        LOGBACK,
        LOGBACK_CORE,
        SLF4J,
    ],
)

# Browser (TeaVM) variant of :core — the same engine/GUI cluster, but with the
# socket-based NetBaseClient swapped for a socket-free stub. The netplay states
# aren't reachable from the web entry point, but every mode's netplay lifecycle
# hooks statically reach NetBaseClient.send -> java.net.Socket, which TeaVM's
# classlib lacks; the stub keeps the reachable graph java.net-free. Logback
# stays on the compile classpath (LogConfig references it) but is excluded from
# the deploy jar (see //:web_deploy_env), and is never reached at runtime.
java_library(
    name = "core_web",
    srcs = glob(
        [
            "nullpomino/util/*.java",
            "nullpomino/game/**/*.java",
            "nullpomino/gui/*.java",
            "nullpomino/gui/net/*.java",
            "nullpomino/gui/sdl/*.java",
            "nullpomino/gui/sdl/widget/*.java",
            "nullpomino/tool/airankstool/*.java",
        ],
        exclude = ["nullpomino/game/net/NetBaseClient.java"],
    ) + ["//src/main/java-webstub:netbaseclient_webstub"],
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":sdl_binding",
        LOGBACK,
        LOGBACK_CORE,
        SLF4J,
    ],
)

# Browser entry point (TeaVM): selects the JSO backend, seeds the virtual
# filesystem, registers a netplay-free set of modes and states, then runs the
# shared SDL main loop.
java_library(
    name = "teavm_main",
    srcs = glob(["nullpomino/gui/teavm/*.java"]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":core_web",
        ":sdl_binding",
        ":sdl_binding_teavm",
        SLF4J,
    ] + TEAVM_JSO,
)

java_library(
    name = "tool_musiclisteditor",
    srcs = glob(["nullpomino/tool/musiclisteditor/*.java"]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":core",
        SLF4J,
    ],
)

java_library(
    name = "tool_ruleeditor",
    srcs = glob(["nullpomino/tool/ruleeditor/*.java"]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":core",
        ":swing_tool_util",
        SLF4J,
    ],
)

java_library(
    name = "tool_sequencer",
    srcs = glob(["nullpomino/tool/sequencer/*.java"]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":core",
        ":swing_tool_util",
        SLF4J,
    ],
)

# Umbrella target preserving the historical :nullpomino label so existing
# consumers (tests, downstream BUILD files) keep working unchanged.
java_library(
    name = "nullpomino",
    visibility = ["//visibility:public"],
    exports = [
        ":core",
        ":sdl_binding",
        ":sdl_binding_jna",
        ":swing_tool_util",
        ":tool_musiclisteditor",
        ":tool_ruleeditor",
        ":tool_sequencer",
    ],
)
