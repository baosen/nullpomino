# Browser (TeaVM) variant of :core — the exact same engine/GUI cluster, so it
# reuses the same split targets rather than re-declaring (and recompiling)
# every file a second time. NetBaseClient is transport-free (the room path
# supplies WebRTC/TCP transports behind the RoomNet seam), so no source
# overrides are needed to keep the reachable graph java.net-free. Logback
# stays on the compile classpath (LogConfig references it) but is excluded
# from the deploy jar (see //:web_deploy_env), and is never reached at
# runtime.
java_library(
    name = "core_web",
    visibility = ["//visibility:public"],
    exports = [":core"],
)

# Browser entry point (TeaVM): selects the JSO backend, seeds the virtual
# filesystem, registers a netplay-free set of modes and states, then runs the
# shared SDL main loop.
java_library(
    name = "teavm_main",
    srcs = glob(["nullpomino/gui/teavm/**/*.java"]),
    javacopts = JAVACOPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":core_web",
        ":sdl_binding",
        ":sdl_binding_teavm",
        SLF4J,
    ] + TEAVM_JSO,
)

