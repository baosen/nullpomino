load("@rules_java//java:defs.bzl", "java_binary")

# Phase 1 TeaVM feasibility spike (see the plan doc / project memory for
# context). Throwaway targets — not wired into any production build.

# Test A: game-logic bytecode compatibility, deliberately logging-isolated.
# No logback on the classpath; slf4j-api falls back to its built-in no-op
# provider, so a failure here can only be the game logic itself.
java_binary(
    name = "SpikeMain",
    srcs = ["SpikeMain.java"],
    main_class = "nullpomino.teavmspike.SpikeMain",
    deps = ["//src/main/java:game_logic_spike"],
)

# Test A variant: same game logic, plus the real logback-classic/Joran
# XML-configuration path NullpoMinoWeb.java exercises today, to isolate a
# logback/Joran-specific failure from a game-logic failure.
java_binary(
    name = "SpikeMainWithLogback",
    srcs = [
        "SpikeMain.java",
        "SpikeMainWithLogback.java",
    ],
    main_class = "nullpomino.teavmspike.SpikeMainWithLogback",
    deps = [
        "//src/main/java:game_logic_spike",
        "@maven//:ch_qos_logback_logback_classic",
        "@maven//:ch_qos_logback_logback_core",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

# Test B: Canvas2D + keyboard JS-interop plumbing, fully independent of
# Test A's game-logic outcome.
java_binary(
    name = "CanvasSmokeTest",
    srcs = ["CanvasSmokeTest.java"],
    main_class = "nullpomino.teavmspike.CanvasSmokeTest",
    deps = [
        "@maven//:org_teavm_teavm_jso_apis",
    ],
)

# The teavm_compiler target lives in //tools/teavm now (it's needed by the
# production web build, not just this spike).
