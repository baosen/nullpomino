<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging for the browser build: console only (CheerpJ maps stdout/stderr
     to the browser console); no file appenders writing into IndexedDB. -->
<configuration>
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{0}: %msg%n</pattern>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="CONSOLE" />
	</root>
</configuration>
