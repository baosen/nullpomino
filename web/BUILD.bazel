load("@rules_java//java:defs.bzl", "java_binary")
load(":teavm.bzl", "teavm_js")

# Bazel-facing driver for TeaVMTool. The classlib and compiler plugins stay as
# ordinary Maven dependencies on the launcher's classpath; TeaVMCompiler adds
# that classpath to the application deploy jar when invoking TeaVMTool.
# teavm-extras-slf4j is a TeaVM compiler plugin
# (META-INF/services/org.teavm.vm.spi.TeaVMPlugin), discovered from the
# compilation classpath, that substitutes a TeaVM-native logger for
# slf4j-api's ServiceLoader/SecurityManager-based bootstrap.
java_binary(
    name = "teavm_compiler",
    srcs = ["TeaVMCompiler.java"],
    main_class = "nullpomino.build.teavm.TeaVMCompiler",
    visibility = ["//visibility:private"],
    runtime_deps = [
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_teavm_teavm_classlib",
        "@maven//:org_teavm_teavm_extras_slf4j",
    ],
    deps = [
        "@maven//:org_teavm_teavm_core",
        "@maven//:org_teavm_teavm_tooling",
    ],
)

# TeaVM ahead-of-time compile: the Java 17 app jar -> web/classes.js.
#
# TeaVM 0.15 requires Java 17 or newer to run. The default build config uses
# remotejdk_17 and emits Java 17 bytecode. Tagged "manual" to keep this
# web/TeaVM-specific artifact out of a plain `bazel build //...` sweep.
#
# Strict mode is REQUIRED: without it TeaVM omits array-bounds and
# null checks for speed, so out-of-range accesses read `undefined` instead of
# throwing. The game relies on Java exception semantics in hot paths — e.g.
# Field.getBlock catches ArrayIndexOutOfBoundsException to return null for
# off-field cells, which the renderer hits every frame. Without --strict that
# read returns undefined and the next deref crashes the game loop. The bounds
# checks cost a few percent of frame time (still a comfortable 60 FPS).
teavm_js(
    name = "classes_js",
    out = "classes.js",
    classpath = ["//:NullpoMinoTeaVM_deploy.jar"],
    main_class = "nullpomino.gui.teavm.NullpoMinoTeaVM",
    optimization = "SIMPLE",
    strict = True,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
