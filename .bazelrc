build --java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_language_version=11

coverage --instrumentation_filter=^//src/main/java[/:]

# `bazel run` executes from the runfiles tree, but the SDL frontend and the
# Swing tools resolve config/ and res/ relative to the working directory. cd
# back to the workspace root first so `bazel run //:NullpoMinoSDL` finds its
# graphics/config instead of drawing a black screen (matches ./NullpoMino).
run --run_under='cd "$BUILD_WORKSPACE_DIRECTORY" &&'
