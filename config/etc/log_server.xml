<configuration>
  <appender name="A1" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{"HH:mm:ss,SSS"} [%thread] %-5level %logger{0}: %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="A2" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>log/log_server.txt</file>
    <append>true</append>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>log/log_server.txt.%i</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>10</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>5MB</maxFileSize>
    </triggeringPolicy>
    <encoder>
      <pattern>%d{"yy-MM-dd HH:mm:ss,SSS"} [%thread] %-5level %logger: %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="A1"/>
    <appender-ref ref="A2"/>
  </root>
</configuration>
