<configuration>
  <appender name="A1" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{"HH:mm:ss,SSS"} [%thread] %-5level %logger{0}: %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="A2" class="ch.qos.logback.core.FileAppender">
    <file>log/log.txt</file>
    <append>false</append>
    <encoder>
      <pattern>%d{"yy-MM-dd HH:mm:ss,SSS"} [%thread] %-5level %logger: %msg%n</pattern>
    </encoder>
  </appender>

  <root level="ALL">
    <appender-ref ref="A1"/>
    <appender-ref ref="A2"/>
  </root>
</configuration>
