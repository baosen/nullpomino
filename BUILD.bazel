load("@rules_java//java:defs.bzl", "java_binary", "java_library")

filegroup(
    name = "config_files",
    srcs = glob(["config/**/*"]),
    visibility = ["//visibility:public"],
)

# Manifest of all default config files, read by the web bootstrap to seed
# the persistent /files virtual filesystem on first run.
genrule(
    name = "config_manifest",
    srcs = [":config_files"],
    outs = ["config-manifest.txt"],
    cmd = "printf '%s\\n' $(SRCS) | sort > $@",
)

# Default config packaged as jar resources. The files keep their
# workspace-relative paths (config/setting/sdl.cfg etc.) as resource names,
# and the manifest lands at /config-manifest.txt.
java_library(
    name = "web_defaults",
    resources = [
        "web/logback-web.xml",
        ":config_files",
        ":config_manifest",
    ],
)

java_binary(
    name = "NullpoMinoSDL",
    main_class = "nullpomino.gui.sdl.NullpoMinoSDL",
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    runtime_deps = [
        "//src/main/java:core",
        # The JNA desktop backend is resolved by reflection (SdlBackend),
        # so nothing depends on it at compile time.
        "//src/main/java:sdl_binding_jna",
    ],
)

# Browser build: pure-Java backend, no JNA anywhere in the jar. Build the
# deployable jar with `bazel build --config=web //:NullpoMinoWeb_deploy.jar`
# (CheerpJ runs Java 17 bytecode at most); see web/build-site.sh.
java_binary(
    name = "NullpoMinoWeb",
    main_class = "nullpomino.gui.web.NullpoMinoWeb",
    runtime_deps = [
        ":web_defaults",
        "//src/main/java:web_main",
    ],
)

# Deployment-environment stub: classes on its runtime classpath are EXCLUDED
# from NullpoMinoTeaVM_deploy.jar. Logback cannot compile under TeaVM (Joran,
# SAX, ServiceLoader), so excluding it turns any accidental reachability into a
# fast "class not found" at TeaVM compile time instead of an obscure failure.
# It stays on core_web's compile classpath (LogConfig references it) and is
# never reached at runtime in the browser.
java_binary(
    name = "web_deploy_env",
    create_executable = False,
    runtime_deps = [
        "@maven//:ch_qos_logback_logback_classic",
        "@maven//:ch_qos_logback_logback_core",
    ],
)

# Browser build (TeaVM): this jar is never executed on a JVM; it is the input
# app jar fed to the TeaVM ahead-of-time compiler (//web:classes_js). Build it
# with --config=web — TeaVM 0.14's ASM front end rejects bytecode newer than 17.
java_binary(
    name = "NullpoMinoTeaVM",
    main_class = "nullpomino.gui.teavm.NullpoMinoTeaVM",
    deploy_env = [":web_deploy_env"],
    runtime_deps = ["//src/main/java:teavm_main"],
)

java_binary(
    name = "AIRanksTool",
    main_class = "nullpomino.tool.airankstool.AIRanksTool",
    runtime_deps = ["//src/main/java:core"],
)

java_binary(
    name = "Sequencer",
    main_class = "nullpomino.tool.sequencer.Sequencer",
    runtime_deps = ["//src/main/java:tool_sequencer"],
)

java_binary(
    name = "RuleEditor",
    main_class = "nullpomino.tool.ruleeditor.RuleEditor",
    runtime_deps = ["//src/main/java:tool_ruleeditor"],
)

java_binary(
    name = "MusicListEditor",
    main_class = "nullpomino.tool.musiclisteditor.MusicListEditor",
    runtime_deps = ["//src/main/java:tool_musiclisteditor"],
)

java_binary(
    name = "AIRanksTester",
    main_class = "nullpomino.tool.airankstool.AIRanksTester",
    runtime_deps = ["//src/main/java:core"],
)
