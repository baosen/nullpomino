module(
    name = "nullpomino",
    version = "7.6.0-SNAPSHOT",
)

bazel_dep(name = "rules_java", version = "9.6.1")
bazel_dep(name = "rules_jvm_external", version = "6.10")

# Transitive deps of rules_jvm_external; old versions break against
# Bazel 9's rules_cc 0.2.x (CcInfo was moved) and attrs.bzl changes.
# Bumped via MVS so we don't inherit the broken versions.
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "rules_android", version = "0.7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "ch.qos.reload4j:reload4j:1.2.25",
        "net.java.dev.jna:jna:5.16.0",
        "org.junit.jupiter:junit-jupiter:5.10.2",
        "org.junit.platform:junit-platform-console:1.10.2",
    ],
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
)
use_repo(maven, "maven")
